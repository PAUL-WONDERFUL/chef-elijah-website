---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gallery" description="Photo gallery of Chef Elijah Kaseregenyi's work.">
  <section class="section">
    <div class="container narrow">
      <span class="eyebrow">Gallery</span>
      <h1>Gallery</h1>
      <p class="lede">
        Photos of desserts, buffet setups and kitchen work are coming soon.
      </p>
      <div class="placeholder-box">
        Photo gallery will be added here.
      </div>
    </div>
  </section>
</Layout>

<style>
  .narrow {
    max-width: 640px;
  }

  .lede {
    color: var(--ink-soft);
    font-size: 1.05rem;
  }
</style>
