---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services" description="Services offered by Chef Elijah Kaseregenyi.">
  <section class="section">
    <div class="container narrow">
      <span class="eyebrow">Services</span>
      <h1>Services &amp; Pricing</h1>
      <p class="lede">
        A full list of services and pricing is coming soon. In the meantime,
        please get in touch directly to discuss catering, consulting, pastry
        training, or bakery enquiries.
      </p>
      <div class="placeholder-box">
        Services &amp; pricing details will be published here shortly.
      </div>
      <div class="cta-row">
        <a class="btn btn--primary" href="/contact">Enquire Now</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .narrow {
    max-width: 640px;
  }

  .lede {
    color: var(--ink-soft);
    font-size: 1.05rem;
  }

  .cta-row {
    margin-top: 1.5rem;
  }
</style>
