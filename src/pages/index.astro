---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import chefPortrait from '../assets/images/chef-elijah-portrait.jpg';
import chefPortraitCutout from '../assets/images/chef-elijah-portrait-cutout.png';
import specialtyDesserts from '../assets/images/specialty-desserts.jpg';
import specialtyPastry from '../assets/images/specialty-pastry.jpg';
import specialtyCatering from '../assets/images/specialty-catering.jpg';
import { getManifest } from '../lib/blobStore';

export const prerender = false;

const highlights = [
  { number: '35+', label: 'Years in professional kitchens' },
  { number: '4', label: 'Countries worked across' },
  { number: '6', label: 'Leadership & consultant roles' },
];

const specialties = [
  {
    image: specialtyDesserts,
    title: 'Classic Dessert Artistry',
    description: 'Chocolate art, decoration, pralines and truffles, built on refined European technique.',
  },
  {
    image: specialtyPastry,
    title: 'International Pastry & Baking',
    description: 'Master Bakers trained in Switzerland, with bread technology and international cake making.',
  },
  {
    image: specialtyCatering,
    title: 'Buffet & Event Catering',
    description: 'Menu engineering, large-scale buffet set-ups and full event catering management.',
  },
];

const manifest = await getManifest();
const profileImageUrl = manifest.profileImageUrl;
---

<Layout title="Home">
  <section class="hero section">
    <div class="container hero__inner">
      <div class="hero__text hero-enter">
        <span class="eyebrow">Chef &amp; Confectioner General</span>
        <h1>Chef Elijah Kaseregenyi</h1>
        <p class="hero__lede">
          Over three decades of pastry craft and kitchen leadership from Sheraton
          Kampala to Dubai, and hotels and resorts across Uganda bringing classic
          technique, chocolate artistry, and disciplined kitchen management to every
          table.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contact">Get in Touch</a>
          <a class="btn btn--ghost" href="/experience">View Experience</a>
        </div>
      </div>
      <div class="hero__portrait-wrap hero-enter" style="animation-delay: 0.15s;">
        <div class="hero__arch"></div>
        <div class="hero__glow"></div>
        {profileImageUrl ? (
          <div class="hero__portrait img-zoom">
            <img src={profileImageUrl} alt="Chef Elijah Kaseregenyi" width="420" height="520" />
          </div>
        ) : (
          <Image
            src={chefPortraitCutout}
            alt="Chef Elijah Kaseregenyi"
            width={700}
            height={933}
            class="hero__portrait-cutout"
          />
        )}
        <div class="hero__badge">
          <span class="hero__badge-icon">&#9733;</span>
          Gold Medal Award Winner
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container grid grid--3">
      {highlights.map((item) => (
        <div class="card highlight">
          <div class="highlight__number">{item.number}</div>
          <div class="highlight__label">{item.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Specialties</span>
      <h2>Areas of Expertise</h2>
      <div class="grid grid--3 specialties-grid">
        {specialties.map((item) => (
          <div class="card specialty-card">
            <div class="specialty-card__img img-zoom">
              <Image src={item.image} alt={item.title} width={240} height={240} />
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container intro">
      <div>
        <span class="eyebrow">Career Objective</span>
        <h2>Kitchen and food excellence, uncompromised.</h2>
        <p>
          Chef Elijah has held executive kitchen roles at Sheraton Kampala Hotel and
          Coral Deira Dubai, trained in Switzerland, Germany, Qatar and Belgium, and
          gone on to lead operations and food &amp; beverage teams at resorts and
          hotels across Uganda most recently as C.E.O of The Special Quality
          Bakers, Wakiso.
        </p>
        <a class="btn btn--ghost" href="/about">Read Full Bio &rarr;</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initCounters() {
    const counters = document.querySelectorAll<HTMLElement>('.highlight__number');
    if (!counters.length) return;

    const animate = (el: HTMLElement) => {
      const raw = el.textContent || '';
      const match = raw.match(/\d+/);
      if (!match || match.index === undefined) return;
      const target = parseInt(match[0], 10);
      const suffix = raw.slice(match.index + match[0].length);
      const duration = 900;
      const start = performance.now();

      function tick(now: number) {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = `${Math.round(eased * target)}${suffix}`;
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    };

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.5 }
    );
    counters.forEach((el) => observer.observe(el));
  }

  document.addEventListener('astro:page-load', initCounters);
</script>

<style>
  .hero {
    padding-top: 5rem;
    padding-bottom: 4rem;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    margin-bottom: 0.6rem;
  }

  .hero__lede {
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: 620px;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .hero__portrait-wrap {
    position: relative;
    max-width: 380px;
    margin: 0 auto;
    aspect-ratio: 10 / 11;
  }

  .hero__arch {
    position: absolute;
    inset: 0;
    background: linear-gradient(185deg, var(--surface), var(--bg-alt));
    border: 1px solid var(--border);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    z-index: 0;
  }

  .hero__glow {
    position: absolute;
    inset: 6% 2% 10% 2%;
    background: radial-gradient(circle, rgba(201, 154, 74, 0.45), transparent 70%);
    filter: blur(32px);
    z-index: 0;
  }

  /* Rectangular fallback frame, used only for admin-uploaded replacement photos */
  .hero__portrait {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .hero__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* True background-removed cutout: sits on top of the arch, bottom-anchored
     so the figure rises slightly above the arch like a real photo cutout. */
  .hero__portrait-cutout {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: 94%;
    height: auto;
    z-index: 2;
    filter: drop-shadow(0 16px 24px rgba(0, 0, 0, 0.5));
  }

  .hero__badge {
    position: absolute;
    top: 1.5rem;
    right: -1.25rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
    box-shadow: 0 0 20px rgba(201, 154, 74, 0.3), 0 8px 20px -8px rgba(0, 0, 0, 0.6);
  }

  .hero__badge-icon {
    color: var(--accent-dark);
  }

  @media (max-width: 780px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__portrait-wrap {
      max-width: 280px;
    }

    .hero__badge {
      right: 0;
      font-size: 0.75rem;
      padding: 0.45rem 0.85rem;
    }
  }

  .highlight {
    text-align: center;
  }

  .highlight__number {
    font-family: 'Playfair Display', serif;
    font-size: 2.25rem;
    color: var(--accent-dark);
    font-weight: 700;
  }

  .highlight__label {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }

  .intro {
    max-width: 720px;
  }

  .specialties-grid {
    margin-top: 1.5rem;
  }

  .specialty-card {
    text-align: center;
  }

  .specialty-card__img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 1px solid var(--border);
    margin: 0 auto 1.25rem;
  }

  .specialty-card__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .specialty-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .specialty-card p {
    color: var(--ink-soft);
    font-size: 0.92rem;
    margin: 0;
  }
</style>
